# Copy to .env and fill in. NEVER commit .env.
# Phase 1-2 need NO keys: the interactive Cursor agent is the LLM.

# Phase 3 (publishing) - only if you choose these routes
PUBLORA_API_KEY=
LINKEDIN_PLATFORM_ID=
LINKEDIN_API_KEY=

# Optional, off by default: image generation provider keys (Phase 2+)
AI_API_KEY=

# Optional, Phase 6 only: unattended runs through the Cursor SDK
CURSOR_API_KEY=
